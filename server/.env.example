# Server
PORT=5001
NODE_ENV=development

# MongoDB — set USE_MEMORY_DB=true if MongoDB is not installed locally
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Client URL (for CORS & Socket.io)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
